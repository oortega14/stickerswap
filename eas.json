{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "REEMPLAZAR_con_tu_email_de_apple_developer",
        "ascAppId": "REEMPLAZAR_con_app_id_de_app_store_connect",
        "appleTeamId": "REEMPLAZAR_con_team_id_de_developer_apple_com"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "alpha"
      }
    }
  }
}
